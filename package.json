{
  "name": "sessio",
  "private": true,
  "version": "0.5.0-beta.7",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "changelogithub": {
    "types": {
      "feat": {
        "title": "🚀 Features"
      },
      "fix": {
        "title": "🐞 Bug Fixes"
      },
      "perf": {
        "title": "⚡ Performance"
      },
      "refactor": {
        "title": "🛠 Refactors"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "ci:build": "tauri build --no-bundle",
    "tauri": "tauri",
    "release": "run-script-os",
    "release:win32": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1",
    "release:default": "./scripts/release.sh",
    "bundle": "tauri build"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.4.0",
    "@lobehub/icons": "^5.8.0",
    "@pierre/diffs": "^1.1.22",
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "katex": "^0.16.47",
    "lucide-react": "^1.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.1.0"
  },
  "devDependencies": {
    "@iconify-json/fluent": "^1.2.49",
    "@iconify-json/material-symbols": "^1.2.76",
    "@iconify-json/mynaui": "^1.2.17",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.86",
    "@iconify-json/solar": "^1.2.5",
    "@iconify/tailwind": "^1.2.0",
    "@tauri-apps/cli": "^2.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "run-script-os": "^1.1.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.7"
  }
