{
  "name": "sessio",
  "private": true,
  "version": "0.3.1",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "changelogithub": {
    "types": {
      "feat": {
        "title": "🚀 Features"
      },
      "fix": {
        "title": "🐞 Bug Fixes"
      },
      "perf": {
        "title": "⚡ Performance"
      },
      "refactor": {
        "title": "🛠 Refactors"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "ci:build": "tauri build --no-bundle",
    "tauri": "tauri",
    "release": "run-script-os",
    "release:win32": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1",
    "release:default": "./scripts/release.sh",
    "bundle": "tauri build"
  },
  "dependencies": {
    "@lobehub/icons": "^5.8.0",
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "lucide-react": "^1.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "run-script-os": "^1.1.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
